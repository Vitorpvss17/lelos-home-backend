# Copie este arquivo para `.env` e ajuste os valores.
# O `.env` real é ignorado pelo git (NUNCA versione segredos).

# Banco
POSTGRES_DB=lelos_home
POSTGRES_USER=lelos
POSTGRES_PASSWORD=troque-esta-senha

# JWT — use >= 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-forte-com-no-minimo-32-caracteres
JWT_EXPIRATION_MS=28800000

# WhatsApp (formato internacional: 55 + DDD + número)
WHATSAPP_NUMBER=5511999999999

# Admin inicial (criado no primeiro boot se não existir)
ADMIN_EMAIL=admin@leloshome.com
ADMIN_PASSWORD=troque-esta-senha-admin

# CORS — em produção, domínio(s) do front separados por vírgula.
# Ex.: https://leloshome.com,https://www.leloshome.com
CORS_ALLOWED_ORIGINS=*
